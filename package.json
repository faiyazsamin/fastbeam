{
  "name": "fastbeam",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-only, peer-to-peer file and text sharing. fastbeam.app",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
